---
import Base from '../layouts/Base.astro';
import Related from './Related.astro';
import { groups, iconFor, UPDATED, type Group } from '../lib/data';
interface Props { g: Group }
const { g } = Astro.props;
const path = `/trades/${g.slug}/`;
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://leedshomeguide.co.uk/' },
  { '@type': 'ListItem', position: 2, name: 'Find a trade', item: 'https://leedshomeguide.co.uk/trades/' },
  { '@type': 'ListItem', position: 3, name: g.name, item: `https://leedshomeguide.co.uk${path}` } ] };
const otherGroups = groups.filter((x) => x.key !== g.key);
---
<Base title={`${g.name} trades in Leeds | Leeds Home Guide`} description={`${g.intro} Local Leeds firms, with the checks we have made shown on each card. Free to use.`} path={path} schema={[crumbs]} noindex={g.live.length === 0}>
  <section class="page-head"><div class="wrap">
    <p class="crumbs"><a href="/">Home</a> › <a href="/trades/">Find a trade</a> › {g.name}</p>
    <h1>{g.name} trades in Leeds</h1>
    <p class="lede">{g.intro} Updated {UPDATED}.</p>
  </div></section>
  <div class="wrap">
    {g.live.length > 0 && (
      <ul class="hg-services grp-services">
        {g.live.map((c) => (
          <li><a class={`hg-svc is-${c.key}`} href={`/trades/${c.slug}/`}>
            <span class="hg-svc-art" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconFor(c.key)} /></span>
            <span class="hg-svc-body"><span class="hg-svc-name">{c.name}</span><span class="hg-svc-line">{c.firms.length} Leeds firms</span></span>
          </a></li>
        ))}
      </ul>
    )}
    {g.live.length === 0 && <p class="notice">We have not published a {g.name.toLowerCase()} list yet. The trades below are being added over the coming weeks.</p>}
    {g.soon.length > 0 && (<>
      <h2 class="soon-h">Coming soon</h2>
      <ul class="chips pills">{g.soon.map((s) => <li><span class="chip pill">{s}</span></li>)}</ul>
    </>)}
    <p class="grp-cta">Run a Leeds {g.name === 'Cleaning & Services' ? 'cleaning or service' : g.name.toLowerCase()} business? <a href="/get-listed/">Get listed free</a></p>
    <h2 class="soon-h">Other trade groups</h2>
    <ul class="chips">{otherGroups.map((x) => <li><a href={`/trades/${x.slug}/`}>{x.name}</a></li>)}</ul>
  </div>
</Base>
