---
// Listing request and contact forms. Posts to /api/form (a Cloudflare Pages Function in /functions/api/form.js),
// which emails the details on. The destination address lives only in the Pages project settings (FORM_TO),
// never in the page. Works without JavaScript too (the function redirects to a thank-you page).
import { groups } from '../lib/data';
import { FORM_ALIAS } from '../site.config';
interface Props { kind: 'listing' | 'contact' }
const { kind } = Astro.props;
const trades = groups.flatMap((g) => [...g.live.map((c) => c.name), ...g.soon]);
const areas = ['Leeds city centre', 'Adel', 'Alwoodley', 'Armley', 'Beeston', 'Bramley', 'Chapel Allerton', 'Cross Gates', 'Farsley', 'Garforth', 'Guiseley', 'Headingley', 'Horsforth', 'Hunslet', 'Kirkstall', 'Meanwood', 'Moortown', 'Morley', 'Otley', 'Pudsey', 'Rothwell', 'Roundhay', 'Seacroft', 'Wetherby', 'Yeadon', 'All of Leeds'];
const id = `f-${kind}`;
---
<div class="lf-wrap" id="form">
  <form class="lf" id={id} action="/api/form" method="post" novalidate data-kind={kind}>
    <input type="hidden" name="form" value={kind} />
    <div class="lf-hp" aria-hidden="true"><label>Leave this empty<input type="text" name="company_fax" tabindex="-1" autocomplete="off" /></label></div>
    {kind === 'listing' ? (<>
      <div class="lf-row">
        <label>Business name<input type="text" name="business" required autocomplete="organization" maxlength="120" /></label>
        <label>Trade<select name="trade" required>
          <option value="">Choose your trade</option>
          {trades.map((t) => <option>{t}</option>)}
          <option>Other</option>
        </select></label>
      </div>
      <div class="lf-row">
        <label>Contact name<input type="text" name="name" required autocomplete="name" maxlength="120" /></label>
        <label>Phone<input type="tel" name="phone" required autocomplete="tel" inputmode="tel" maxlength="40" /></label>
      </div>
      <div class="lf-row">
        <label>Email<input type="email" name="email" required autocomplete="email" maxlength="160" /></label>
        <label><span>Website <span class="lf-opt">(optional)</span></span><input type="url" name="website" autocomplete="url" inputmode="url" placeholder="https://" maxlength="200" /></label>
      </div>
      <label>Area of Leeds you cover<input type="text" name="area" required list="lf-areas" maxlength="200" placeholder="e.g. Headingley, Horsforth, all of Leeds" /></label>
      <datalist id="lf-areas">{areas.map((a) => <option value={a} />)}</datalist>
      <label><span>Message <span class="lf-opt">(optional)</span></span><textarea name="message" rows="4" maxlength="3000" placeholder="The work you do, how long you have traded, any registers you are on"></textarea></label>
    </>) : (<>
      <div class="lf-row">
        <label>Your name<input type="text" name="name" required autocomplete="name" maxlength="120" /></label>
        <label>Your email<input type="email" name="email" required autocomplete="email" maxlength="160" /></label>
      </div>
      <label>Your message<textarea name="message" rows="5" required maxlength="3000"></textarea></label>
    </>)}
    <label class="lf-consent"><input type="checkbox" name="consent" value="yes" required /><span>I agree that Leeds Home Guide can use these details to {kind === 'listing' ? 'consider my listing and contact me about it' : 'reply to my message'}, as set out in the <a href="/privacy/">privacy policy</a>.</span></label>
    <p class="lf-err" role="alert" hidden></p>
    <button class="btn lf-btn" type="submit">{kind === 'listing' ? 'Send listing request' : 'Send message'}</button>
  </form>
  <div class="lf-thanks" role="status" tabindex="-1" hidden>
    <span class="lf-tick" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span>
    <h2>Thank you, it's sent</h2>
    <p>{kind === 'listing' ? 'We have your details. We check every business against our criteria and will be in touch by email or phone, usually within a few working days.' : 'We have your message and will reply by email, usually within a few working days.'}</p>
  </div>
</div>
<script is:inline define:vars={{ id, alias: FORM_ALIAS }}>
(function () {
  var f = document.getElementById(id); if (!f || !window.fetch) return;
  var wrap = f.parentNode, err = f.querySelector('.lf-err'), btn = f.querySelector('.lf-btn'), label = btn.textContent;
  function fail(m) { err.textContent = m; err.hidden = false; btn.disabled = false; btn.textContent = label; }
  f.addEventListener('submit', function (e) {
    e.preventDefault(); err.hidden = true;
    var bad = f.querySelector(':invalid');
    if (bad) { var l = bad.closest('label'); fail('Please fill in ' + (bad.type === 'checkbox' ? 'the consent box' : (l ? l.childNodes[0].textContent.trim().toLowerCase() : 'every required field')) + '.'); bad.focus(); return; }
    btn.disabled = true; btn.textContent = 'Sending...';
    fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
      .then(function (j) {
        if (j && j.fallback && alias) {
          var d = new FormData(f); d.delete('company_fax'); d.append('_subject', (f.dataset.kind === 'listing' ? 'Listing request: ' + d.get('business') : 'Contact form: ' + d.get('name'))); d.append('_template', 'table'); d.append('_captcha', 'false');
          return fetch('https://formsubmit.co/ajax/' + alias, { method: 'POST', body: d, headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (k) { return { ok: k && (k.success === true || k.success === 'true') }; });
        }
        return j;
      })
      .then(function (j) {
        if (j && j.ok) { f.hidden = true; var t = wrap.querySelector('.lf-thanks'); t.hidden = false; t.focus({ preventScroll: true }); wrap.scrollIntoView({ behavior: 'smooth', block: 'start' }); return; }
        fail((j && j.error) || 'Sorry, that did not send. Please try again, or email hello@leedshomeguide.co.uk.');
      })
      .catch(function () { fail('Sorry, that did not send. Please check your connection and try again.'); });
  });
})();
</script>
