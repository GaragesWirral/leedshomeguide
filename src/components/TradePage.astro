---
import Base from '../layouts/Base.astro';
import Related from './Related.astro';
import { UPDATED, CHECKED, telHref, type Category } from '../lib/data';
interface Props { c: Category }
const { c } = Astro.props;
const path = `/trades/${c.slug}/`;
const url = `https://leedshomeguide.co.uk${path}`;
const isAsb = c.key === 'asbestos';
const tips: Record<string, string[]> = {
  roofers: ['Get at least two written quotes that list the materials, scaffolding and waste removal.', 'Ask whether the work comes with a written guarantee, and who backs it if the firm stops trading.', 'For a listed building or a house in a conservation area, check with Leeds City Council before changing roof materials.'],
  plumbers: ['Anyone working on a gas boiler, fire or hob must be on the Gas Safe Register. Ask to see their ID card and check it at gassaferegister.co.uk.', 'Ask for the call out fee and hourly rate before an emergency visit.', 'Know where your stop tap is before you need it.'],
  electricians: ['Check registration on the NICEIC or NAPIT websites before work starts.', 'For notifiable work such as a new consumer unit or a rewire, ask for the Building Regulations certificate when the job is done.', 'Landlords: keep your latest EICR to hand. Selective licence conditions in Leeds say you must give the council a declaration that the wiring is safe if it asks.'],
  asbestos: ['If you think a material contains asbestos, leave it alone until it has been tested.', 'Check a removal firm\'s licence on the HSE register of licensed asbestos contractors, for work that needs one.', 'Householders can take small amounts of properly wrapped asbestos to the council\'s Kirkstall site by appointment.'],
};
const expertTips: Record<string, { body: string; by: string; src: string; url: string }> = {
  asbestos: { by: 'HSE guidance', src: 'HSE: Asbestos frequently asked questions', url: 'https://www.hse.gov.uk/asbestos/faq.htm',
    body: 'Most work on asbestos cement, which is what many garage roofs are made of, can be done without an HSE licence. How it is done matters more. Breaking or smashing the sheets releases far more fibres, so intact sheets should come off whole and be double wrapped and labelled, not broken into smaller pieces. Ask any firm that quotes how it will take the sheets off and wrap them.' },
  roofers: { by: 'Citizens Advice', src: 'Citizens Advice: Cancelling building or decorating work', url: 'https://www.citizensadvice.org.uk/consumer/getting-home-improvements-done/cancelling-building-or-decorating-work/',
    body: 'If you agree roofing work at your home or in the street, for example with a roofer who knocks on your door, you usually get at least 14 days to cancel and get your money back, starting the day after you say yes. This does not usually cover urgent repairs you called someone in for, so never feel rushed into a big job on the doorstep.' },
  plumbers: { by: 'HSE advice', src: 'HSE: Check an engineer is Gas Safe registered', url: 'https://www.hse.gov.uk/gas/gas-safe-register-check.htm',
    body: 'Check that the engineer at your door is the one on the register. Enter the licence number from their Gas Safe ID card on the Gas Safe Register website to see their photo and what gas work they are qualified for, or text the word Gas and the seven digit licence number to 85080.' },
  electricians: { by: 'Electrical Safety First guidance', src: 'Electrical Safety First: Part P of the Building Regulations', url: 'https://www.electricalsafetyfirst.org.uk/find-a-registered-electrician/part-p-of-the-building-regulations/',
    body: 'When a registered electrician finishes the job, you should get two documents: an Electrical Installation Certificate (or a Minor Works Certificate for smaller jobs) and a Building Regulations Compliance Certificate. Keep both with your house papers, as homeowners and landlords must be able to show the work meets the rules.' },
};
const g: any = c as any;
const tip = g.expert_tip || expertTips[c.key];
const checks: string[] = g.checks || tips[c.key] || [];
const faqs: { q: string; a: string }[] = g.faqs || [];
const guide: { h2: string; p?: string[]; ul?: string[] }[] = g.guide || [];
const schema: object[] = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://leedshomeguide.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Find a trade', item: 'https://leedshomeguide.co.uk/trades/' },
    { '@type': 'ListItem', position: 3, name: c.title, item: url } ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: `${c.title} (2026)`, url, numberOfItems: c.firms.length,
    itemListElement: c.firms.map((f, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'LocalBusiness', name: f.name, url: f.url, ...(f.phone ? { telephone: f.phone } : {}), areaServed: 'Leeds' } })) },
];
if (faqs.length) schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const seoTitle = g.seo_title || `${c.title} (2026): ${c.firms.length} local firms | Leeds Home Guide`;
const seoDesc = g.seo_desc || `${c.firms.length} ${c.name.toLowerCase()} firms that work in Leeds, picked on published criteria. What each one does, where they are based and how to check them. Updated ${UPDATED}.`;
---
<Base title={seoTitle} description={seoDesc} path={path} schema={schema}>
  <section class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> › <a href="/trades/">Find a trade</a> › {c.name}</p>
      <h1>{g.h1 || c.title}</h1>
      <p class="lede">{c.intro}</p>
      <p class="meta">Updated {UPDATED}</p>
    </div>
  </section>
  <div class="wrap with-side">
    <div class="main-col">
      <p class="notice"><b>How we check:</b> the details on each card come from Companies House, the trade scheme's own register and the firm's own website. Before work starts, ask the firm for proof of its public liability insurance.</p>
      {tip && (
        <aside class="expert">
          <p class="eyebrow">Expert tip</p>
          <p><b>Based on {tip.by}:</b> {tip.body}</p>
          <p class="tip-src">Source: <a href={tip.url} rel="noopener" target="_blank">{tip.src}</a></p>
        </aside>
      )}
      <p class="list-count">{c.firms.length} {g.list_label || 'firms we recommend in Leeds'}</p>
      <ol class="pro-list">
        {c.firms.map((f, i) => (
          <li class="card firm" id={f.domain.replace(/\./g, '-')}>
            <div class="firm-head">
              {f.logo
                ? <span class={`firm-logo${f.logo_bg === 'dark' ? ' on-dark' : ''}`}><img src={f.logo} alt={`${f.name} logo`} width="48" height="48" loading="lazy" decoding="async" /></span>
                : <span class="avatar" aria-hidden="true">{f.name.replace(/^the\s+/i, '').slice(0, 1)}</span>}
              <div class="firm-id">
                <h3>{f.name}</h3>
                <p class="meta">{f.area}</p>
              </div>
            </div>
            {f.rating && <p class="g-rating"><a href={f.rating.url} rel="noopener" target="_blank">Google rating {f.rating.score} from {f.rating.count} reviews</a></p>}
            <ul class="ticks">{f.claims.map((cl) => <li>{cl}</li>)}</ul>
            <p class="why"><b>Why they are here:</b> {f.why}</p>
            <p class="svc-line">{f.services.join(', ')}</p>
            <div class="actions">
              {f.phone && <a class="btn" href={telHref(f.phone)}>Call {f.phone}</a>}
              <a class="firm-web" href={f.url} rel="noopener" target="_blank">Visit website</a>
            </div>
          </li>
        ))}
      </ol>
      <section class="checks-sec">
        <h2>Before you hire: three quick checks</h2>
        <ol class="steps">{checks.map((t) => <li>{t}</li>)}</ol>
      </section>
      {guide.length > 0 && (
        <section class="trade-guide">
          {guide.map((s) => (<>
            <h2>{s.h2}</h2>
            {(s.p || []).map((t) => <p set:html={t} />)}
            {s.ul && <ul>{s.ul.map((t) => <li set:html={t} />)}</ul>}
          </>))}
        </section>
      )}
      {faqs.length > 0 && (<section class="faq"><h2>Questions people ask</h2>{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>)}
      {isAsb && (<p><a href="/guides/asbestos-garage-roof-removal-leeds/">Read our guide to asbestos garage roof removal in Leeds</a></p>)}
    </div>
    <aside class="side-col">
      <div class="side-box method">
        <h2>How we choose</h2>
        <ul>
          <li>Based in or regularly working in Leeds</li>
          <li>Company status looked up on Companies House where the firm is registered</li>
          <li>Accreditations: where we have looked one up, the card says so</li>
          <li>Google reviews read for patterns, and the card says so where we have</li>
          <li>We list up to 3 firms per trade and show on each card which checks we have made</li>
        </ul>
        <p class="meta"><a href="/how-we-choose/">Read our full method</a></p>
      </div>
    </aside>
  </div>
  <Related trade={c} />
</Base>
