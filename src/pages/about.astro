import Base from '../layouts/Base.astro';
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Leeds Home Guide', url: 'https://leedshomeguide.co.uk/', logo: 'https://leedshomeguide.co.uk/favicon.svg', description: 'An independent guide to looking after a Leeds home: local trades with the checks we have made shown on each card, what jobs cost and council rules made simple.', areaServed: { '@type': 'City', name: 'Leeds' } };
const page = { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'About Leeds Home Guide', url: 'https://leedshomeguide.co.uk/about/', inLanguage: 'en-GB' };
---
<Base title="About Leeds Home Guide | Who we are and how the guide works" description="Leeds Home Guide is an independent guide to looking after a Leeds home: local trades with the checks we have made shown on each card, what jobs cost, and council rules made simple." path="/about/" schema={[org, page]}>
  <section class="page-head"><div class="wrap narrow"><p class="crumbs"><a href="/">Home</a> › About</p><h1>About Leeds Home Guide</h1><p class="lede">A free, independent guide for people who own, rent out or look after a home in Leeds.</p></div></section>
  <article class="wrap narrow prose">
    <h2>What the guide is</h2>
    <p>Leeds has everything from Victorian back to backs to 1960s estates and new flats in the city centre. Each type of home throws up its own jobs, costs and rules. We put the useful parts in one place: a short list of local trades for each job, with the checks we have made shown on each card, what the work should cost, and the council rules that apply in Leeds.</p>
    <h2>Who runs it</h2>
    <p>Leeds Home Guide is written and checked by the Leeds Home Guide team. The guide is free to use.</p>
    <h2>How firms get on a list</h2>
    <p>We list up to 3 firms per trade and show on each card which checks we have made. Where we have looked a firm up ourselves on an official register, such as Companies House, Gas Safe, NICEIC, NAPIT, TrustMark or the HSE register of licensed asbestos contractors, the card says so, including where a firm is on the HSE licence list. Other details, such as services and years trading, come from the firm's own website. The full method is on <a href="/how-we-choose/">How we check</a>.</p>
    <h2>Where our facts come from</h2>
    <p>Prices, charges and rules come from official sources such as Leeds City Council, the Health and Safety Executive and GOV.UK, or from named cost guides. Every guide shows the date we last checked it and lists its sources at the bottom.</p>
    <h2>Get in touch</h2>
    <p>Spotted something wrong, or run a Leeds trade? <a href="/contact/">Contact us</a> or see <a href="/get-listed/">Get listed</a>.</p>
  </article>
</Base>
