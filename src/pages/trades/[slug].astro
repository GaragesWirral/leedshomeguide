---
import TradePage from '../../components/TradePage.astro';
import GroupPage from '../../components/GroupPage.astro';
import { categories, groups } from '../../lib/data';
export function getStaticPaths() {
  const clash = groups.filter((g) => categories.some((c) => c.slug === g.slug));
  if (clash.length) throw new Error(`group slug clashes with a trade slug: ${clash.map((g) => g.slug).join(', ')}`);
  return [
    ...categories.map((c) => ({ params: { slug: c.slug }, props: { c } })),
    ...groups.map((g) => ({ params: { slug: g.slug }, props: { g } })),
  ];
}
const { c, g } = Astro.props as any;
---
{c ? <TradePage c={c} /> : <GroupPage g={g} />}
