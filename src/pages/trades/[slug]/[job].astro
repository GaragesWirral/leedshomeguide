---
// Job pages inside a trade (e.g. /trades/plumbers/emergency-plumber/). Built from src/data/jobs.json.
import Base from '../../../layouts/Base.astro';
import Related from '../../../components/Related.astro';
import { categories, jobs, jobPath, telHref, UPDATED } from '../../../lib/data';
export function getStaticPaths() {
  return jobs.map((j) => {
    const c = categories.find((x) => x.key === j.trade)!;
    return { params: { slug: c.slug, job: j.slug }, props: { j, c } };
  });
}
const { j, c } = Astro.props as any;
const path = jobPath(j);
const schema: object[] = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://leedshomeguide.co.uk/' },
  { '@type': 'ListItem', position: 2, name: c.name, item: `https://leedshomeguide.co.uk/trades/${c.slug}/` },
  { '@type': 'ListItem', position: 3, name: j.name, item: `https://leedshomeguide.co.uk${path}` } ] }];
if (j.faqs?.length) schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: j.faqs.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<Base title={j.title} description={j.description} path={path} schema={schema}>
  <section class="page-head"><div class="wrap">
    <p class="crumbs"><a href="/">Home</a> › <a href={`/trades/${c.slug}/`}>{c.name}</a> › {j.name}</p>
    <h1>{j.h1 || j.name}</h1>
    <p class="lede">{j.intro}</p>
    <p class="meta">Updated {UPDATED}</p>
  </div></section>
  <div class="wrap narrow">
    <section class="trade-guide">
      {(j.sections || []).map((s: any) => (<>
        <h2>{s.h2}</h2>
        {(s.p || []).map((t: string) => <p set:html={t} />)}
        {s.ul && <ul>{s.ul.map((t: string) => <li set:html={t} />)}</ul>}
      </>))}
    </section>
    <h2>{c.name} in Leeds we list</h2>
    <ul class="h-which">{c.firms.map((f: any) => <li><span class="h-which-job">{f.name}, {f.area}</span>{f.phone ? <a href={telHref(f.phone)}>Call {f.phone}</a> : <a href={f.url} rel="noopener" target="_blank">Visit website</a>}</li>)}</ul>
    <p><a href={`/trades/${c.slug}/`}>See the full {c.name.toLowerCase()} list and our checks</a></p>
    {j.faqs?.length > 0 && (<section class="faq"><h2>Questions people ask</h2>{j.faqs.map((f: any) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>)}
  </div>
  <Related trade={c} jobSlug={j.slug} />
</Base>
